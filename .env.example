# Copy to .env and fill in local secrets. Never commit .env.
# Existing process environment variables override .env values.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_SECURITY=tls
SMTP_USER=your-sender@163.com
SMTP_PASSWORD=
SMTP_FROM=your-sender@163.com

# Payment: keep disabled until a provider is deliberately configured. Use mock only locally.
PAY_PROVIDER=disabled
PAY_HUIFU_BASE_URL=https://api.huifu.com
PAY_HUIFU_SYS_ID=
PAY_HUIFU_PRODUCT_ID=
PAY_HUIFU_ID=
PAY_HUIFU_PRIVATE_KEY_FILE=
PAY_HUIFU_PLATFORM_PUBLIC_KEY_FILE=
PAY_HUIFU_NOTIFY_URL=https://prompt.osh.lol/api/payments/notify/huifu
PAY_HUIFU_PROXY_TOKEN=
PAY_HUIFU_CONNECT_TIMEOUT_MS=5000
PAY_HUIFU_READ_TIMEOUT_MS=10000
